# Copiar a .env y completar con valores reales. NUNCA commitear el .env.
# Todas las variables de este archivo son obligatorias: el servidor sale con
# error claro si alguna falta (misma convención que ya usaba DATABASE_URL).

# --- Base de datos ----------------------------------------------------------
# Cadena de conexión de PostgreSQL (Supabase). La URL ya incluye usuario y
# contraseña, p. ej.: postgresql://usuario:clave@host:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Firma de tokens JWT ----------------------------------------------------
# Clave secreta para firmar los tokens. Debe ser larga y aleatoria.
# Generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# --- Usuario administrador inicial -----------------------------------------
# Contraseña con la que se crea el usuario 'admin' la primera vez que se
# inicializan las tablas. Después se puede cambiar desde la interfaz.
ADMIN_INITIAL_PASSWORD=

# --- HTTP / CORS ------------------------------------------------------------
# Orígenes permitidos (separados por coma). La SPA de Vite usa 5173 en local.
CORS_ORIGIN=http://localhost:5173
PORT=3001

# --- SSL de Postgres --------------------------------------------------------
# Dejar vacío para usar SSL (necesario en Supabase). `disable` solo en Postgres
# local sin TLS. PGSSL_REJECT_UNAUTHORIZED=true exige certificado verificable.
# DATABASE_SSL=disable
# PGSSL_REJECT_UNAUTHORIZED=true